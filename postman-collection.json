{
  "info": {
    "_postman_id": "readyforms-security-tests",
    "name": "ReadyForms Security & Smoke Tests",
    "description": "Postman collection for testing ReadyForms client and API across localhost and production environments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "client_prod",
      "value": "https://readyforms.vercel.app"
    },
    {
      "key": "server_prod",
      "value": "https://readyforms-api.vercel.app"
    },
    {
      "key": "server_local",
      "value": "http://localhost:3001"
    },
    {
      "key": "client_local",
      "value": "http://localhost:8000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "test_email",
      "value": "test@example.com"
    },
    {
      "key": "test_password",
      "value": "TestPass123!"
    }
  ],
  "item": [
    {
      "name": "0. Preflight - Environment Configuration",
      "item": [
        {
          "name": "Check Client Production",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_prod}}",
              "host": ["{{client_prod}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Client production responds', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('CORS headers present', () => {",
                  "    pm.response.to.have.header('Access-Control-Allow-Origin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Server Production Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/health",
              "host": ["{{server_prod}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Server production health is OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.test('Status is ok', () => {",
                  "        pm.expect(json.status).to.eql('ok');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Server Localhost Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_local}}/health",
              "host": ["{{server_local}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Server localhost health is OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Security Headers & CORS",
      "item": [
        {
          "name": "Verify Security Headers - Production",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/api/status",
              "host": ["{{server_prod}}"],
              "path": ["api", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Content-Type-Options is nosniff', () => {",
                  "    pm.response.to.have.header('x-content-type-options', 'nosniff');",
                  "});",
                  "pm.test('X-Frame-Options is DENY', () => {",
                  "    pm.response.to.have.header('x-frame-options', 'DENY');",
                  "});",
                  "pm.test('Referrer-Policy is strict-origin-when-cross-origin', () => {",
                  "    pm.response.to.have.header('referrer-policy', 'strict-origin-when-cross-origin');",
                  "});",
                  "pm.test('HSTS is present', () => {",
                  "    pm.response.to.have.header('strict-transport-security');",
                  "});",
                  "pm.test('CSP is present', () => {",
                  "    pm.response.to.have.header('content-security-policy');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Security Headers - Localhost",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_local}}/api/status",
              "host": ["{{server_local}}"],
              "path": ["api", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Content-Type-Options is nosniff', () => {",
                  "    pm.response.to.have.header('x-content-type-options', 'nosniff');",
                  "});",
                  "pm.test('X-Frame-Options is DENY', () => {",
                  "    pm.response.to.have.header('x-frame-options', 'DENY');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS - Allowed Origin",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://readyforms.vercel.app"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": {
              "raw": "{{server_prod}}/api/status",
              "host": ["{{server_prod}}"],
              "path": ["api", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CORS allows production origin', () => {",
                  "    pm.response.to.have.header('access-control-allow-origin', 'https://readyforms.vercel.app');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication Flow",
      "item": [
        {
          "name": "Register - Production",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/register",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration returns 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains token and user', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json.user).to.have.property('email');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Localhost",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User Local\",\n  \"email\": \"localtest@example.com\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{server_local}}/api/auth/register",
              "host": ["{{server_local}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Local registration returns 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Production",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/login",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains token', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Localhost",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"localtest@example.com\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{server_local}}/api/auth/login",
              "host": ["{{server_local}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Local login returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - Production (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{server_prod}}/api/auth/me",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get current user returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('User object has id, email, name', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('email');",
                  "    pm.expect(json).to.have.property('name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - No Token (Should 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/api/auth/me",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized without token returns 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Rate Limiting Tests",
      "item": [
        {
          "name": "Rate Limit - Login Burst (Production)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ratelimit@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/login",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rate limit headers present', () => {",
                  "    pm.response.to.have.header('x-ratelimit-limit');",
                  "    pm.response.to.have.header('x-ratelimit-remaining');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate Limit - OTP Burst (Production)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"otptest@example.com\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/send-otp",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "send-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP rate limit headers present', () => {",
                  "    pm.response.to.have.header('x-ratelimit-limit');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Dashboard & Protected Routes",
      "item": [
        {
          "name": "Dashboard Stats - Production (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{server_prod}}/api/dashboard/stats",
              "host": ["{{server_prod}}"],
              "path": ["api", "dashboard", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dashboard stats returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Stats contain expected keys', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('templates');",
                  "    pm.expect(json).to.have.property('responses');",
                  "    pm.expect(json).to.have.property('likes');",
                  "    pm.expect(json).to.have.property('comments');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard Stats - No Token (Should 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/api/dashboard/stats",
              "host": ["{{server_prod}}"],
              "path": ["api", "dashboard", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized dashboard access returns 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Topics List - Production (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/api/topics",
              "host": ["{{server_prod}}"],
              "path": ["api", "topics"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Topics list returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Open Redirect & Input Validation",
      "item": [
        {
          "name": "Login Page Redirect Validation - External URL (Should Block)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_prod}}/auth/login?redirect=https://evil.com",
              "host": ["{{client_prod}}"],
              "path": ["auth", "login"],
              "query": [
                {
                  "key": "redirect",
                  "value": "https://evil.com"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login page loads without redirecting to external site', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.not.include('evil.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Page Redirect Validation - javascript: URL (Should Block)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_prod}}/auth/login?redirect=javascript:alert(1)",
              "host": ["{{client_prod}}"],
              "path": ["auth", "login"],
              "query": [
                {
                  "key": "redirect",
                  "value": "javascript:alert(1)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login page blocks javascript: redirect', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.not.include('javascript:');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Page Redirect Validation - Valid Internal Path (Should Allow)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{client_prod}}/auth/login?redirect=/dashboard",
              "host": ["{{client_prod}}"],
              "path": ["auth", "login"],
              "query": [
                {
                  "key": "redirect",
                  "value": "/dashboard"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login page allows internal redirect', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. SQL Injection & Input Fuzzing",
      "item": [
        {
          "name": "SQL Injection - Login with SQL Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin' OR '1'='1\",\n  \"password\": \"anything\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/login",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SQL injection returns 401 or 400, not 200', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS - OTP Email Field with Script Tag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<script>alert(1)</script>@example.com\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{server_prod}}/api/auth/send-otp",
              "host": ["{{server_prod}}"],
              "path": ["api", "auth", "send-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS payload is rejected or sanitized', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "    pm.expect(pm.response.text()).to.not.include('<script>');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Debug & Info Disclosure",
      "item": [
        {
          "name": "Debug Routes Should Not Expose internals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/api/debug",
              "host": ["{{server_prod}}"],
              "path": ["api", "debug"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Debug routes are protected or return 404', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Root Endpoint Info Disclosure Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{server_prod}}/",
              "host": ["{{server_prod}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Root endpoint does not leak secrets', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('secret');",
                  "    pm.expect(json).to.not.have.property('database_url');",
                  "    pm.expect(json).to.not.have.property('api_key');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
