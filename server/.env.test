# Test environment configuration
NODE_ENV=test

# Database config
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
TEST_DB_NAME=readyforms_test
DB_PORT=5432

# JWT config for tests
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h

# Allow all origins for testing
ALLOW_ALL_ORIGINS=true

# Test server port
TEST_PORT=4000

# Enable test logging (set to true for debugging)
TEST_LOGS=false

