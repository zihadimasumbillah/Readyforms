{
  "name": "server",
  "version": "1.0.0",
  "description": "ReadyForms API server",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "jest tests/health.test.js tests/api.test.js --forceExit --runInBand",
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc && cp -r api dist/",
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node src/utils/seed.ts",
    "setup-test-data": "ts-node src/utils/ensure-test-users.ts",
    "reset-db": "ts-node src/utils/reset-database.ts",
    "scan-routes": "ts-node src/utils/scan-for-invalid-routes.ts",
    "postinstall": "npm run build",
    "clean-routes": "node src/utils/clean-debug-routes.js",
    "safe-start": "npm run clean-routes && npm run build && npm start",
    "add-columns": "ts-node src/utils/add-missing-columns.ts",
    "fix-db": "npm run add-columns",
    "fix-admin": "ts-node src/utils/fix-admin.ts",
    "prepare-test": "npm run fix-admin && npm run test",
    "debug:scan": "ts-node src/utils/run-debug-scan.ts",
    "debug:templates": "ts-node src/utils/debug-templates.ts",
    "ensure-test-users": "ts-node src/utils/ensure-test-users.ts",
    "test:setup": "NODE_ENV=test ts-node tests/setup-test-db.ts",
    "test:setup-db": "ts-node tests/setup-test-db.ts",
    "pretest": "tsc",
    "test:api": "npm run test:setup-db && npm run pretest && NODE_ENV=test jest tests/api.test.js --config=jest.config.js --forceExit --detectOpenHandles --runInBand --testTimeout=60000",
    "test:extended-api": "npm run pretest && jest tests/extended-api.test.js --config=jest.config.js --forceExit --detectOpenHandles --runInBand",
    "test:all": "npm run pretest && jest tests/*.test.js --config=jest.config.js --forceExit --detectOpenHandles --runInBand",
    "vercel-build": "npm run build && cp -r api dist/",
    "install-faker": "npm install @faker-js/faker@8.4.1",
    "setup-db": "npm install @faker-js/faker@8.4.1 --save && npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "tar": "^7.5.21",
    "form-data": "^4.0.6",
    "lodash": "^4.17.21",
    "minimatch": "^9.0.7",
    "js-yaml": "^4.1.0",
    "brace-expansion": "^1.1.18",
    "picomatch": "^2.3.2",
    "glob": "^10.5.0"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "openai": "^6.22.0",
    "path-to-regexp": "^6.2.1",
    "pg": "^8.11.3",
    "pg-connection-string": "^2.6.2",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
