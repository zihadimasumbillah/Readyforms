# ─── Server Production Configuration ─────────────────────────────────────────
# THIS FILE MUST NOT CONTAIN REAL SECRETS.
# Set all values below in the Vercel project's Environment Variables dashboard.
# See: https://vercel.com/docs/projects/environment-variables

NODE_ENV=production
PORT=3000

# Client URLs for CORS (comma-separated list of all allowed origins)
# Set in Vercel dashboard: CLIENT_URL
CLIENT_URL=REPLACE_IN_VERCEL_DASHBOARD

# ⚠️  SECURITY: ALLOW_ALL_ORIGINS must be false in production
ALLOW_ALL_ORIGINS=false

# Neon Database Configuration
# ⚠️  CRITICAL: Rotate these credentials at neon.tech IMMEDIATELY if they were previously committed.
# Set in Vercel dashboard: DATABASE_URL, DATABASE_URL_UNPOOLED
DATABASE_URL=REPLACE_IN_VERCEL_DASHBOARD
DATABASE_URL_UNPOOLED=REPLACE_IN_VERCEL_DASHBOARD
USE_DIRECT_URL=true

# Authentication secrets
# ⚠️  CRITICAL: Generate a new 256-bit secret: `openssl rand -hex 32`
# Set in Vercel dashboard: JWT_SECRET, JWT_EXPIRES_IN
JWT_SECRET=REPLACE_IN_VERCEL_DASHBOARD
JWT_EXPIRES_IN=24h

# API Base URL for cross-service communication
API_BASE_URL=https://readyforms-api.vercel.app

